page {
  background: linear-gradient(180deg, #fff0f5 0%, #ffe8ee 100%);
  min-height: 100vh;
}

.page {
  padding: 0 24rpx 40rpx;
}

/* ==================== 顶部 Banner ==================== */
.top-banner {
  position: relative;
  height: 320rpx;
  background: linear-gradient(135deg, #ff9eb5 0%, #ff6b8a 50%, #ff4466 100%);
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
  margin: -24rpx -24rpx 30rpx;
}

.banner-deco {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background:
    radial-gradient(circle at 20% 30%, rgba(255,255,255,0.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(255,255,255,0.1) 0%, transparent 40%);
}

.banner-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.banner-title {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  letter-spacing: 4rpx;
}

.banner-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

/* ==================== 卡片通用 ==================== */
.card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 150, 170, 0.1);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* ==================== 邀请码 ==================== */
.code-box {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fff5f7, #ffe8ee);
  border-radius: 20rpx;
  padding: 28rpx;
  border: 2rpx dashed #ffb6c1;
}

.code-text {
  font-size: 56rpx;
  font-weight: 900;
  color: #ff6b8a;
  letter-spacing: 8rpx;
}

.copy-badge {
  margin-left: 24rpx;
  background: #ff6b8a;
  color: white;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.code-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 16rpx;
}

/* ==================== 输入框 ==================== */
.invite-input {
  width: 100%;
  height: 88rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
}

.input-placeholder {
  color: #ccc;
  font-size: 26rpx;
}

.bind-btn {
  margin-top: 24rpx;
  width: 100%;
  background: linear-gradient(135deg, #ff6b8a, #ff9eb5);
  color: white;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 138, 0.35);
  box-sizing: border-box;
}

.bind-btn::after {
  border: none;
}

/* ==================== 请求卡片 ==================== */
.req-card {
  background: #fafafa;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #f0f0f0;
  overflow: hidden;
  box-sizing: border-box;
}

.req-card:last-child {
  margin-bottom: 0;
}

.req-card.sent {
  border-color: #fff3e0;
  background: linear-gradient(135deg, #fffbf5, #fff8f0);
}

.req-card.received {
  border-color: #ffe0ec;
  background: linear-gradient(135deg, #fffafe, #fff5f8);
}

.req-card-top {
  display: flex;
  align-items: center;
}

.req-card-avatar {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.req-card-avatar.sent-avatar {
  background: linear-gradient(135deg, #fff3e0, #ffe0b2);
}

.req-card-avatar.received-avatar {
  background: linear-gradient(135deg, #ffe0ec, #ffccd5);
}

.req-card-meta {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.req-card-code {
  font-size: 28rpx;
  font-weight: 700;
  color: #ff6b8a;
  letter-spacing: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.req-card-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.req-card-badge {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.sent .req-card-badge {
  background: #fff3e0;
  color: #ff9800;
}

.received .req-card-badge.new {
  background: #ffe0ec;
  color: #ff4081;
  animation: badgePulse 2s ease-in-out infinite;
}

@keyframes badgePulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.req-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.req-card-time {
  font-size: 20rpx;
  color: #bbb;
  flex-shrink: 0;
}

.req-card-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.req-card-action {
  font-size: 22rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-weight: 600;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.req-card-action:active {
  transform: scale(0.95);
}

.req-card-action.cancel {
  background: #f5f5f5;
  color: #999;
}

.req-card-action.reject {
  background: #f0f0f0;
  color: #888;
}

.req-card-action.agree {
  background: linear-gradient(135deg, #ff6b8a, #ff9eb5);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 138, 0.25);
}

/* ==================== 空状态 ==================== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.empty-heart {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #ccc;
}

/* ==================== 已绑定状态 ==================== */
.bound {
  padding-top: 30rpx;
}

.couple-card {
  background: white;
  border-radius: 32rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 6rpx 30rpx rgba(255, 150, 170, 0.15);
}

.couple-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.couple-badge {
  display: inline-block;
  background: linear-gradient(135deg, #fff0f5, #ffe8ee);
  color: #ff6b8a;
  font-size: 28rpx;
  font-weight: 600;
  padding: 12rpx 40rpx;
  border-radius: 999rpx;
  border: 2rpx solid #ffb6c1;
}

.couple-bodies {
  display: flex;
  align-items: center;
  justify-content: center;
}

.couple-person {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
}

.couple-avatar-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  padding: 6rpx;
}

.couple-avatar-wrap.me {
  background: linear-gradient(135deg, #ff6b8a, #ff9eb5);
}

.couple-avatar-wrap.partner {
  background: linear-gradient(135deg, #6b8aff, #9eb5ff);
}

.couple-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #f5f5f5;
  border: 4rpx solid white;
}

.couple-name {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.couple-code {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #bbb;
  letter-spacing: 2rpx;
}

.couple-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 20rpx;
  width: 120rpx;
}

.link-line {
  width: 2rpx;
  height: 40rpx;
  background: linear-gradient(180deg, #ffb6c1, #ffd6e0);
}

.link-heart {
  font-size: 36rpx;
  margin: 8rpx 0;
}

/* ==================== 解绑区域 ==================== */
.unbind-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
}

.unbind-tip {
  font-size: 22rpx;
  color: #ccc;
  margin-bottom: 16rpx;
}

.unbind-btn {
  font-size: 26rpx;
  color: #bbb;
  background: #f8f8f8;
  border-radius: 999rpx;
  padding: 0 60rpx;
  line-height: 2.2;
  border: none;
}

.unbind-btn::after {
  border: none;
}
