page { background: linear-gradient(180deg, #fff0f5 0%, #ffe8ee 30%, #ffd6e0 100%); min-height: 100vh; }
.page { padding: 24rpx 28rpx 20rpx; }

/* ==================== 未绑定 ==================== */
.unbound-card { display:flex; flex-direction:column; align-items:center; padding:120rpx 60rpx; }
.unbound-emoji { font-size:100rpx; margin-bottom:24rpx; }
.unbound-title { font-size:34rpx; font-weight:700; color:#d44a6a; margin-bottom:12rpx; }
.unbound-desc { font-size:26rpx; color:#999; }

/* ==================== 年度标题 ==================== */
.year-header {
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 20rpx; padding: 16rpx 0;
}
.year-arrow {
  width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: #ff6b8a; background: rgba(255,107,138,0.06); border-radius: 50%;
}
.year-center { display: flex; flex-direction: column; align-items: center; margin: 0 36rpx; }
.year-num { font-size: 64rpx; font-weight: 900; color: #d44a6a; line-height: 1.1; }
.year-label { font-size: 22rpx; color: #bbb; font-weight: 600; margin-top: 2rpx; }

/* ==================== 创建按钮 ==================== */
.add-goal-btn {
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  padding: 18rpx; margin-bottom: 18rpx;
  background: rgba(255,255,255,0.65); backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx); border-radius: 20rpx;
  border: 2rpx dashed rgba(255,107,138,0.25); color: #ff6b8a;
  font-size: 26rpx; font-weight: 600;
}
.agb-icon { font-size: 32rpx; font-weight: 300; }

/* ==================== 创建表单 ==================== */
.form-card {
  background: rgba(255,255,255,0.78); backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx); border-radius: 24rpx;
  padding: 22rpx; margin-bottom: 18rpx;
  box-shadow: 0 4rpx 20rpx rgba(255,107,138,0.06); border: 1rpx solid rgba(255,255,255,0.6);
}
.form-input {
  height: 84rpx; background: #fafafa; border-radius: 16rpx; padding: 0 20rpx;
  font-size: 28rpx; box-sizing: border-box; margin-bottom: 16rpx; color: #333;
}
.form-btns { display: flex; gap: 14rpx; }
.form-cancel {
  flex: 1; text-align: center; padding: 16rpx 0; background: #f5f5f5;
  border-radius: 999rpx; font-size: 24rpx; color: #999; font-weight: 600;
}
.form-confirm {
  flex: 1; text-align: center; padding: 16rpx 0;
  background: linear-gradient(135deg, #ff9eb5, #ff6b8a); color: #fff;
  border-radius: 999rpx; font-size: 24rpx; font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(255,107,138,0.25);
}

/* ==================== 目标卡片 ==================== */
.goal-list { display: flex; flex-direction: column; gap: 16rpx; }

.goal-card {
  background: rgba(255,255,255,0.72); backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx); border-radius: 24rpx;
  padding: 20rpx 22rpx; box-shadow: 0 2rpx 18rpx rgba(255,150,170,0.06);
  border: 1rpx solid rgba(255,255,255,0.5); transition: all 0.3s ease;
  animation: fadeInUp 0.4s ease both;
}
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.goal-card.all-done {
  background: rgba(240,255,240,0.6); border-color: rgba(78,205,196,0.2);
}

.gc-header { margin-bottom: 12rpx; }
.gc-title-row { display: flex; align-items: center; margin-bottom: 10rpx; }
.gc-icon { font-size: 26rpx; margin-right: 8rpx; }
.gc-title { font-size: 28rpx; font-weight: 700; color: #333; flex: 1; }
.gc-owner {
  font-size: 18rpx; padding: 3rpx 12rpx; border-radius: 999rpx;
  background: rgba(255,107,138,0.06); color: #ff9eb5; font-weight: 600;
}

.gc-progress-row { display: flex; align-items: center; gap: 12rpx; }
.gc-progress-bar {
  flex: 1; height: 10rpx; background: #f0f0f0; border-radius: 999rpx; overflow: hidden;
}
.gc-progress-fill {
  height: 100%; background: linear-gradient(90deg, #ffb6c1, #ff6b8a);
  border-radius: 999rpx; transition: width 0.5s ease;
}
.gc-progress-fill.done { background: linear-gradient(90deg, #69db7c, #4ecdc4); }
.gc-progress-text {
  font-size: 20rpx; color: #bbb; font-weight: 600; flex-shrink: 0;
}

/* ==================== 子任务 ==================== */
.gc-tasks { display: flex; flex-direction: column; gap: 8rpx; }

.gc-task {
  display: flex; align-items: center; padding: 12rpx 14rpx;
  background: rgba(255,255,255,0.5); border-radius: 14rpx;
  border: 1rpx solid rgba(255,182,193,0.1); transition: all 0.3s ease;
}
.gc-task.task-done { background: rgba(240,255,240,0.3); border-color: rgba(78,205,196,0.1); }

.task-check {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  border: 2rpx solid #ddd; display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: transparent; flex-shrink: 0; margin-right: 12rpx;
  transition: all 0.25s ease;
}
.task-check.checked {
  background: #4ecdc4; border-color: #4ecdc4; color: #fff;
}

.task-text {
  flex: 1; font-size: 26rpx; color: #555; transition: all 0.3s ease;
}
.gc-task.task-done .task-text {
  color: #ccc; text-decoration: line-through;
}

.task-del {
  width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: #ddd; flex-shrink: 0;
}

/* ==================== 添加子任务 ==================== */
.gc-add-task {
  display: flex; align-items: center; gap: 6rpx; margin-top: 12rpx;
  padding: 10rpx 16rpx; font-size: 22rpx; color: #ffb6c1; font-weight: 600;
}
.gat-icon { font-size: 26rpx; }

.gc-task-input-row { display: flex; gap: 10rpx; margin-top: 8rpx; }
.gc-task-input {
  flex: 1; height: 68rpx; background: #fafafa; border-radius: 14rpx;
  padding: 0 16rpx; font-size: 24rpx; box-sizing: border-box; color: #333;
}
.gc-task-confirm {
  padding: 0 24rpx; height: 68rpx; line-height: 68rpx;
  background: linear-gradient(135deg, #ff9eb5, #ff6b8a); color: #fff;
  border-radius: 14rpx; font-size: 24rpx; font-weight: 600; flex-shrink: 0;
}

/* ==================== 删除 ==================== */
.gc-delete {
  text-align: center; margin-top: 12rpx; padding: 10rpx;
  font-size: 20rpx; color: #ddd; transition: color 0.2s;
}

/* ==================== 空状态 ==================== */
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; }
.empty-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #bbb; font-weight: 600; }
.empty-sub { font-size: 22rpx; color: #ddd; margin-top: 8rpx; }

.bottom-space { height: 40rpx; }
