page {
  background: #f7f7f7;
}

.container {
  padding: 30rpx;
}

.title {
  font-size: 56rpx;
  font-weight: bold;
  color: #9b59b6;
  margin-top: 30rpx;
}

.card {
  margin-top: 30rpx;
  background: white;
  border-radius: 30rpx;
  padding: 30rpx;
}

.textarea {
  background: #f5f5f5;
  border-radius: 20rpx;
  padding: 20rpx;
  height: 240rpx;
  margin-bottom: 20rpx;
}

.image-row {
  margin-bottom: 20rpx;
}

.preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
}

.remove-img {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9b59b6;
}

.btn-row {
  display: flex;
  gap: 20rpx;
}

.btn {
  flex: 1;
  background: #9b59b6;
  color: white;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.btn-secondary {
  flex: 1;
  background: #f0e6f6;
  color: #9b59b6;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.list {
  margin-top: 40rpx;
}

.item {
  background: white;
  border-radius: 30rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
}

.left {
  width: 85%;
}

.item-meta {
  font-size: 24rpx;
  color: #9b59b6;
  margin-bottom: 12rpx;
}

.item-content {
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
}

.item-image {
  margin-top: 16rpx;
  width: 100%;
  border-radius: 16rpx;
}

.delete {
  color: #9b59b6;
  font-size: 26rpx;
  align-self: center;
}

.empty {
  text-align: center;
  color: #bbb;
  font-size: 28rpx;
  padding: 60rpx 0;
}
