<view class="page">
  <view class="hero">
    <view class="hero-bg"></view>
    <view class="hero-top">
      <view>
        <text class="hero-title">情侣朋友圈</text>
        <text class="hero-subtitle">记录只属于你们的小日常</text>
      </view>
      <image class="hero-avatar" src="{{myAvatar || defaultAvatar}}" mode="aspectFill" bindtap="chooseMyAvatar"></image>
    </view>
  </view>

  <view class="publish-card">
    <view class="publish-main">
      <image class="publish-avatar" src="{{myAvatar || defaultAvatar}}" mode="aspectFill" bindtap="chooseMyAvatar"></image>
      <view class="publish-content">
        <textarea
          class="publish-textarea"
          placeholder="分享今天的心动瞬间..."
          placeholder-class="publish-placeholder"
          value="{{content}}"
          bindinput="onInput"
          maxlength="500"
          auto-height
        ></textarea>
      </view>
    </view>

    <view class="publish-images" wx:if="{{images.length > 0}}">
      <view class="publish-img-item" wx:for="{{images}}" wx:key="*this">
        <image class="publish-img" src="{{item}}" mode="aspectFill"></image>
        <view class="publish-img-remove" data-index="{{index}}" catchtap="removeImage">×</view>
      </view>
      <view class="publish-img-add" wx:if="{{images.length < 9}}" bindtap="chooseImage">
        <text class="publish-add-plus">+</text>
      </view>
    </view>

    <view class="publish-footer">
      <view class="publish-tool" bindtap="chooseImage">
        <text class="publish-tool-icon">🖼️</text>
        <text>照片</text>
      </view>
      <button class="publish-btn" bindtap="publish" disabled="{{!content && images.length === 0}}">发布</button>
    </view>
  </view>

  <view class="moment-list">
    <view class="moment-card" wx:for="{{list}}" wx:key="_id">
      <view class="moment-head">
        <image class="moment-avatar {{item.isMine ? 'avatar-mine' : 'avatar-partner'}}" src="{{item.authorAvatar || defaultAvatar}}" mode="aspectFill"></image>
        <view class="moment-user">
          <view class="moment-name-row">
            <text class="moment-name">{{item.authorName || '匿名'}}</text>
            <text class="moment-tag {{item.isMine ? 'tag-mine' : 'tag-partner'}}">{{item.authorLabel}}</text>
          </view>
          <text class="moment-time">{{item.time}}</text>
        </view>
        <view class="moment-more" data-id="{{item._id}}" bindtap="deleteItem">•••</view>
      </view>

      <view class="moment-text" wx:if="{{item.content}}">{{item.content}}</view>

      <view class="moment-imgs img-count-{{item.imageCount}}" wx:if="{{item.imageCount > 0}}">
        <view
          class="moment-img-wrap"
          wx:for="{{item.images}}"
          wx:for-item="img"
          wx:for-index="idx"
          wx:key="*this"
          data-urls="{{item.images}}"
          data-current="{{img}}"
          bindtap="previewImage"
        >
          <image class="moment-img" src="{{img}}" mode="aspectFill"></image>
        </view>
      </view>

      <view class="moment-actions">
        <view class="action-btn {{item.isLiked ? 'liked' : ''}}" data-id="{{item._id}}" bindtap="likeMoment">
          <text class="action-icon">{{item.isLiked ? '❤️' : '🤍'}}</text>
          <text>{{item.isLiked ? '已喜欢' : '喜欢'}}</text>
        </view>
        <view class="action-btn" data-id="{{item._id}}" bindtap="showCommentInput">
          <text class="action-icon">💬</text>
          <text>评论</text>
        </view>
      </view>

      <view class="social-box" wx:if="{{item.likes > 0 || (item.comments && item.comments.length > 0)}}">
        <view class="like-row" wx:if="{{item.likes > 0}}">
          <text class="like-heart">❤️</text>
          <text class="like-text">{{item.likes}} 个喜欢</text>
        </view>
        <view class="comment-list" wx:if="{{item.comments && item.comments.length > 0}}">
          <view class="comment-item" wx:for="{{item.comments}}" wx:for-item="cmt" wx:key="time">
            <text class="comment-name">{{cmt.authorName || '匿名'}}</text>
            <text class="comment-colon">：</text>
            <text class="comment-content">{{cmt.content}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{list.length === 0}}">
      <view class="empty-card">
        <text class="empty-emoji">💌</text>
        <text class="empty-title">还没有动态</text>
        <text class="empty-text">快来发布你们的第一条甜蜜记录吧</text>
      </view>
    </view>
  </view>

  <view class="bottom-safe"></view>

  <view class="comment-modal" wx:if="{{showCommentModal}}" catchtouchmove="noop">
    <view class="modal-mask" bindtap="hideCommentInput" catchtouchmove="noop"></view>
    <view class="comment-sheet">
      <view class="comment-sheet-bar"></view>
      <view class="comment-sheet-head">
        <text class="comment-sheet-title">写评论</text>
        <view class="comment-close" bindtap="hideCommentInput">×</view>
      </view>
      <view class="comment-input-wrap">
        <textarea
          class="comment-textarea"
          placeholder="说点什么吧..."
          placeholder-class="comment-placeholder"
          value="{{commentContent}}"
          bindinput="onCommentInput"
          maxlength="200"
          focus="{{showCommentModal}}"
          auto-height
        ></textarea>
        <button class="comment-send" bindtap="submitComment" disabled="{{!canSubmitComment}}">发送</button>
      </view>
    </view>
  </view>
</view>