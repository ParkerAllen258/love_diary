/* ========== 陪伴小组件 ========== */
.comp-widget {
  margin: 20rpx auto;
  width: 92%;
  padding: 22rpx 26rpx;
  background: rgba(255,255,255,0.72);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(255,107,138,0.07);
  border: 1rpx solid rgba(255,255,255,0.6);
}
.compw-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.compw-title { display: flex; align-items: center; font-size: 24rpx; font-weight: 700; color: #555; }
.compw-icon { margin-right: 6rpx; font-size: 26rpx; }
.compw-arrow { font-size: 20rpx; color: #ff6b8a; font-weight: 500; }
.compw-body { display: flex; flex-direction: column; align-items: center; }

.compw-heart-row { display: flex; align-items: center; justify-content: center; gap: 16rpx; margin-bottom: 6rpx; }
.compw-heart { font-size: 44rpx; transition: transform 0.3s; }
.compw-heart.none { filter: grayscale(1); opacity: 0.4; }
.compw-heart.half { animation: heartPulse 2s ease-in-out infinite; }
.compw-heart.both { animation: heartPulse 1.2s ease-in-out infinite; transform: scale(1.08); }
.compw-heart-emoji { display: block; }

.compw-days-col { display: flex; align-items: baseline; }
.compw-days-num { font-size: 38rpx; font-weight: 900; color: #ff6b8a; line-height: 1.1; }
.compw-days-prefix { font-size: 18rpx; color: #ff6b8a; margin-right: 4rpx; font-weight: 500; }
.compw-days-label { font-size: 20rpx; color: #ff9eb5; margin-left: 3rpx; font-weight: 600; }
.compw-status-text { font-size: 20rpx; color: #aaa; }
