page {
  background: #fdf2f8;
}

.page {
  padding: 24rpx 28rpx 100rpx;
  box-sizing: border-box;
}

/* ========== 页面标题 ========== */
.page-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #db2777;
  padding: 16rpx 8rpx 8rpx;
}

/* ========== 统计卡片 ========== */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(236, 72, 153, 0.06);
  position: relative;
  overflow: hidden;
}

.stat-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  border-radius: 0 0 999rpx 999rpx;
}

.stat-card:nth-child(1)::after {
  background: linear-gradient(90deg, #f472b6, #ec4899);
}

.stat-card.photos::after {
  background: linear-gradient(90deg, #a78bfa, #7c3aed);
}

.stat-card.month::after {
  background: linear-gradient(90deg, #34d399, #10b981);
}

.stat-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #1f2937;
  margin-top: 4rpx;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

/* ========== 新建相册按钮 ========== */
.create-album-btn {
  margin-top: 24rpx;
  text-align: center;
  padding: 28rpx;
  background: linear-gradient(135deg, #f472b6, #ec4899);
  color: #fff;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 30rpx rgba(236, 72, 153, 0.3);
  letter-spacing: 2rpx;
}

/* 快速上传按钮 */
.quick-upload-btn {
  margin-top: 16rpx;
  text-align: center;
  padding: 24rpx;
  background: #fff;
  color: #ec4899;
  border: 2rpx solid #fce7f3;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ========== 相册列表 ========== */
.album-list {
  margin-top: 28rpx;
}

.album-card {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease;
}

.album-card:active {
  transform: scale(0.98);
}

/* 封面 */
.album-cover {
  width: 100%;
  height: 320rpx;
  position: relative;
  background: linear-gradient(135deg, #fce7f3, #fdf2f8);
  overflow: hidden;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fce7f3, #fbcfe8);
}

.cover-emoji {
  font-size: 80rpx;
  opacity: 0.6;
}

.cover-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.35), transparent);
}

.cover-count {
  position: absolute;
  bottom: 20rpx;
  right: 24rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(0, 0, 0, 0.4);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

/* 相册信息 */
.album-info {
  padding: 24rpx;
}

.album-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.album-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #9ca3af;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.album-meta {
  margin-top: 12rpx;
}

.album-date {
  font-size: 22rpx;
  color: #d1d5db;
}

/* 操作按钮 */
.album-actions {
  display: flex;
  border-top: 1rpx solid #fce7f3;
}

.album-act {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.album-act.edit {
  color: #db2777;
  border-right: 1rpx solid #fce7f3;
}

.album-act.del {
  color: #ef4444;
}

/* ========== 详情导航 ========== */
.detail-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 0 16rpx;
  gap: 16rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 28rpx;
  color: #db2777;
  font-weight: 500;
  padding: 8rpx 16rpx 8rpx 0;
}

.nav-arrow {
  font-size: 44rpx;
  line-height: 1;
  font-weight: 300;
}

.nav-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-action {
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #f472b6, #ec4899);
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(236, 72, 153, 0.25);
}

/* ========== 详情头 ========== */
.detail-header {
  margin-top: 12rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.detail-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.detail-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #9ca3af;
}

.detail-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #d1d5db;
}

/* ========== 照片网格（瀑布流双列） ========== */
.photo-grid {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16rpx;
}

.photo-item {
  width: calc(50% - 8rpx);
  border-radius: 20rpx;
  overflow: hidden;
  background: #fce7f3;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.photo-img {
  width: 100%;
  display: block;
  min-height: 240rpx;
}

.photo-mask {
  position: absolute;
  top: 0;
  right: 0;
  padding: 12rpx;
}

.photo-del {
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* ========== 弹窗遮罩 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.modal-card {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 60rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  z-index: 101;
  animation: slideUp 0.3s ease;
  max-height: 80vh;
  overflow-y: auto;
}

@keyframes slideUp {
  from { transform: translateY(100%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
  text-align: center;
  margin-bottom: 28rpx;
}

.modal-cover {
  width: 100%;
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #fce7f3, #fbcfe8);
}

.modal-cover-img {
  width: 100%;
  height: 100%;
}

.modal-cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.modal-cover-emoji {
  font-size: 72rpx;
  opacity: 0.5;
}

.modal-cover-text {
  font-size: 24rpx;
  color: #9ca3af;
}

.modal-group {
  margin-bottom: 20rpx;
}

.modal-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 10rpx;
}

.modal-input {
  height: 80rpx;
  background: #fdf2f8;
  border: 2rpx solid #fce7f3;
  border-radius: 18rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1f2937;
}

.modal-textarea {
  min-height: 120rpx;
  background: #fdf2f8;
  border: 2rpx solid #fce7f3;
  border-radius: 18rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #374151;
}

.modal-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.cancel {
  background: #f3f4f6;
  color: #6b7280;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #f472b6, #ec4899);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(236, 72, 153, 0.3);
}

/* ========== 空状态 ========== */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 28rpx;
  color: #9ca3af;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #d1d5db;
}
