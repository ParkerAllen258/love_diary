page { background: linear-gradient(180deg, #fff0f5 0%, #ffe8ee 30%, #ffd6e0 100%); min-height: 100vh; }
.page { padding: 24rpx 28rpx 20rpx; }

/* ==================== 顶部概览卡片 ==================== */
.hero-card {
  background: rgba(255,255,255,0.72); backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx); border-radius: 28rpx;
  padding: 28rpx 24rpx 22rpx; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(255,107,138,0.08);
  border: 1rpx solid rgba(255,255,255,0.6);
}

.hero-header {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx;
}
.hero-title { font-size: 34rpx; font-weight: 800; color: #d44a6a; }
.hero-toggle {
  font-size: 22rpx; padding: 10rpx 22rpx; border-radius: 999rpx;
  background: rgba(255,107,138,0.08); color: #ff6b8a; font-weight: 600;
  border: 1rpx solid rgba(255,107,138,0.15); transition: all 0.2s;
}
.hero-toggle.active { background: linear-gradient(135deg, #ff9eb5, #ff6b8a); color: #fff; border-color: transparent; }

/* 结余三栏 */
.balance-row { display: flex; align-items: center; margin-bottom: 18rpx; }
.bal-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.bal-label { font-size: 20rpx; color: #aaa; margin-bottom: 6rpx; font-weight: 500; }
.bal-num { font-size: 36rpx; font-weight: 900; }
.bal-num.green { color: #4ecdc4; }
.bal-num.red { color: #ff6b8a; }
.bal-divider { width: 1rpx; height: 40rpx; background: rgba(0,0,0,0.06); }

/* 个人卡片 */
.person-row { display: flex; gap: 14rpx; }
.person-card {
  flex: 1; padding: 16rpx 18rpx; border-radius: 20rpx;
  background: rgba(255,255,255,0.5); border: 1rpx solid rgba(255,182,193,0.2);
}
.pc-name { font-size: 22rpx; color: #888; font-weight: 600; display: block; margin-bottom: 6rpx; }
.pc-in { font-size: 24rpx; color: #4ecdc4; font-weight: 700; margin-right: 14rpx; }
.pc-out { font-size: 24rpx; color: #ff6b8a; font-weight: 700; }

/* 报表模式 */
.report-section { margin-top: 4rpx; }
.report-tabs { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.report-tab {
  flex: 1; text-align: center; padding: 14rpx 0; font-size: 22rpx; font-weight: 600;
  color: #999; background: rgba(255,255,255,0.45); border-radius: 999rpx;
  border: 1rpx solid rgba(255,182,193,0.12);
}
.report-tab.active { background: linear-gradient(135deg, #ff9eb5, #ff6b8a); color: #fff; border-color: transparent; }

.report-summary { display: flex; gap: 12rpx; }
.rs-item {
  flex: 1; display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 600; color: #666;
  padding: 12rpx 6rpx; border-radius: 16rpx; background: rgba(255,255,255,0.5);
}
.rs-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 8rpx; flex-shrink: 0; }
.rs-dot.green { background: #4ecdc4; }
.rs-dot.red { background: #ff6b8a; }

/* ==================== 通用区块卡片 ==================== */
.section-card {
  margin-bottom: 20rpx; padding: 22rpx 22rpx 16rpx;
  background: rgba(255,255,255,0.68); backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx); border-radius: 24rpx;
  box-shadow: 0 2rpx 18rpx rgba(255,150,170,0.06); border: 1rpx solid rgba(255,255,255,0.5);
}
.section-title { display: flex; align-items: center; font-size: 26rpx; font-weight: 700; color: #444; margin-bottom: 16rpx; }
.st-icon { margin-right: 8rpx; font-size: 28rpx; }

/* ==================== 月度统计 ==================== */
.month-list { display: flex; flex-direction: column; gap: 12rpx; }
.month-row { display: flex; align-items: center; gap: 12rpx; }
.mr-label { width: 100rpx; font-size: 20rpx; color: #999; font-weight: 600; flex-shrink: 0; }
.mr-bar-wrap {
  flex: 1; height: 28rpx; background: #f5f5f5; border-radius: 999rpx;
  overflow: hidden; display: flex; position: relative;
}
.mr-bar { height: 100%; }
.mr-bar.mr-out { background: rgba(255,107,138,0.5); }
.mr-bar.mr-in { background: rgba(78,205,196,0.5); }
.mr-amounts { display: flex; flex-direction: column; align-items: flex-end; gap: 2rpx; flex-shrink: 0; }
.mr-out-txt { font-size: 18rpx; color: #ff6b8a; font-weight: 600; }
.mr-in-txt { font-size: 18rpx; color: #4ecdc4; font-weight: 600; }

/* ==================== 分类排行 ==================== */
.cat-list { display: flex; flex-direction: column; gap: 12rpx; }
.cat-row { display: flex; align-items: center; gap: 10rpx; }
.cat-icon {
  width: 44rpx; height: 44rpx; border-radius: 14rpx; display: flex;
  align-items: center; justify-content: center; font-size: 24rpx; flex-shrink: 0;
}
.cat-name { width: 80rpx; font-size: 22rpx; color: #555; font-weight: 600; flex-shrink: 0; }
.cat-amt { width: 110rpx; font-size: 22rpx; color: #666; font-weight: 700; text-align: right; flex-shrink: 0; }
.cat-bar-bg {
  flex: 1; height: 12rpx; background: #f5f5f5; border-radius: 999rpx; overflow: hidden;
}
.cat-bar-fill { height: 100%; border-radius: 999rpx; min-width: 4rpx; transition: width 0.4s ease; }
.cat-pct { width: 50rpx; font-size: 18rpx; color: #bbb; text-align: right; flex-shrink: 0; }

/* ==================== 筛选标签 ==================== */
.filter-tabs {
  display: flex; margin-bottom: 18rpx; background: rgba(255,255,255,0.55);
  border-radius: 999rpx; padding: 6rpx; box-shadow: 0 2rpx 12rpx rgba(255,150,170,0.04);
}
.ftab {
  flex: 1; text-align: center; padding: 16rpx 0; font-size: 24rpx; font-weight: 600;
  color: #999; border-radius: 999rpx; transition: all 0.2s;
}
.ftab.active { background: linear-gradient(135deg, #ff9eb5, #ff6b8a); color: #fff; }

/* ==================== 记账按钮 ==================== */
.add-btn {
  text-align: center; padding: 18rpx; margin-bottom: 18rpx;
  background: linear-gradient(135deg, #ff9eb5, #ff6b8a); color: #fff;
  border-radius: 999rpx; font-size: 26rpx; font-weight: 700;
  box-shadow: 0 6rpx 22rpx rgba(255,107,138,0.28);
  transition: all 0.15s; animation: btnFloat 3s ease-in-out infinite;
}
.add-btn:active { transform: scale(0.95); }
@keyframes btnFloat {
  0%, 100% { transform: translateY(0); box-shadow: 0 6rpx 22rpx rgba(255,107,138,0.28); }
  50% { transform: translateY(-4rpx); box-shadow: 0 10rpx 28rpx rgba(255,107,138,0.38); }
}

/* ==================== 记账表单 ==================== */
.form-card {
  background: rgba(255,255,255,0.78); backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx); border-radius: 24rpx;
  padding: 24rpx; margin-bottom: 18rpx;
  box-shadow: 0 4rpx 20rpx rgba(255,107,138,0.08); border: 1rpx solid rgba(255,255,255,0.6);
}

.type-switch { display: flex; gap: 14rpx; margin-bottom: 20rpx; }
.type-btn {
  flex: 1; text-align: center; padding: 16rpx 0; font-size: 24rpx; font-weight: 600;
  border-radius: 20rpx; background: #f8f8f8; color: #999; border: 2rpx solid transparent;
  transition: all 0.15s;
}
.type-btn.active.exp { background: rgba(255,107,138,0.08); color: #ff6b8a; border-color: #ff6b8a; }
.type-btn.active.inc { background: rgba(78,205,196,0.08); color: #4ecdc4; border-color: #4ecdc4; }

.f-input {
  height: 84rpx; background: #fafafa; border-radius: 18rpx; padding: 0 22rpx;
  font-size: 28rpx; box-sizing: border-box; margin-bottom: 16rpx; color: #333;
}

.f-row { display: flex; gap: 14rpx; margin-bottom: 16rpx; }
.f-picker {
  height: 84rpx; background: #fafafa; border-radius: 18rpx; display: flex;
  align-items: center; justify-content: center; gap: 8rpx;
  font-size: 26rpx; color: #555; padding: 0 18rpx; white-space: nowrap;
}

.f-date {
  height: 84rpx; background: #fafafa; border-radius: 18rpx; display: flex;
  align-items: center; padding: 0 22rpx; font-size: 26rpx; color: #666;
  margin-bottom: 16rpx;
}

.f-submit {
  width: 100%; height: 84rpx; line-height: 84rpx; text-align: center;
  background: linear-gradient(135deg, #ff9eb5, #ff6b8a); color: #fff;
  border-radius: 999rpx; font-size: 26rpx; font-weight: 700; border: none;
  box-shadow: 0 4rpx 16rpx rgba(255,107,138,0.25);
}

.f-author-hint {
  text-align: center; font-size: 22rpx; color: #bbb; margin-bottom: 12rpx;
}
.f-author-name { color: #ff9eb5; font-weight: 600; }

/* ==================== 账单列表 ==================== */
.bill-list { display: flex; flex-direction: column; gap: 14rpx; }

.bill-item {
  display: flex; align-items: flex-start; justify-content: space-between;
  background: rgba(255,255,255,0.72); backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx); border-radius: 22rpx;
  padding: 20rpx; box-shadow: 0 2rpx 14rpx rgba(255,150,170,0.04);
  border: 1rpx solid rgba(255,255,255,0.5);
}

.bi-left { display: flex; flex: 1; min-width: 0; }
.bi-cat {
  width: 64rpx; height: 64rpx; border-radius: 18rpx; display: flex;
  align-items: center; justify-content: center; font-size: 32rpx; flex-shrink: 0;
}
.bi-info { margin-left: 16rpx; flex: 1; min-width: 0; }
.bi-title { font-size: 28rpx; font-weight: 600; color: #333; line-height: 1.3; }
.bi-meta { margin-top: 6rpx; font-size: 20rpx; color: #aaa; display: flex; align-items: center; gap: 4rpx; flex-wrap: wrap; }
.bi-owner { padding: 2rpx 10rpx; border-radius: 8rpx; font-size: 18rpx; font-weight: 600; }
.bi-owner.mine { background: rgba(255,107,138,0.08); color: #ff6b8a; }
.bi-owner.partner { background: rgba(77,171,247,0.08); color: #4dabf7; }
.bi-date { margin-top: 4rpx; font-size: 20rpx; color: #ccc; }
.bi-note { margin-top: 4rpx; font-size: 20rpx; color: #bbb; }

.bi-right { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; margin-left: 14rpx; }
.bi-amount { font-size: 32rpx; font-weight: 900; }
.bi-amount.green { color: #4ecdc4; }
.bi-amount.red { color: #ff6b8a; }
.bi-del { margin-top: 10rpx; font-size: 20rpx; color: #ff8787; padding: 4rpx 12rpx; }

/* ==================== 空状态 ==================== */
/* ==================== 时间选择器 ==================== */
.time-switch {
  display: flex; align-items: center; justify-content: center; gap: 32rpx;
  margin-bottom: 14rpx;
}
.ts-row { display: flex; align-items: center; gap: 8rpx; }
.ys-arrow {
  width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; color: #ff6b8a; background: rgba(255,107,138,0.06); border-radius: 50%;
}
.ys-text { font-size: 24rpx; font-weight: 700; color: #555; }
.ys-text.month-text { font-size: 22rpx; color: #ff6b8a; min-width: 60rpx; text-align: center; }

/* ==================== 饼图区域 ==================== */
.pie-section { display: flex; align-items: flex-start; gap: 28rpx; }
.pie-donut {
  width: 180rpx; height: 180rpx; border-radius: 50%; flex-shrink: 0;
  position: relative; display: flex; align-items: center; justify-content: center;
}
.pie-hole {
  width: 110rpx; height: 110rpx; border-radius: 50%; background: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.pie-total-label { font-size: 18rpx; color: #bbb; }
.pie-total-num { font-size: 22rpx; font-weight: 900; color: #ff6b8a; margin-top: 2rpx; }

.pie-legend { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.pl-item { display: flex; align-items: center; gap: 8rpx; }
.pl-dot { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; }
.pl-name { font-size: 20rpx; color: #666; width: 60rpx; flex-shrink: 0; }
.pl-pct { font-size: 20rpx; color: #999; font-weight: 600; width: 50rpx; flex-shrink: 0; }
.pl-amt { font-size: 20rpx; color: #bbb; }

/* ==================== 双方消费占比 ==================== */
.ratio-section { display: flex; flex-direction: column; gap: 14rpx; }
.ratio-row { display: flex; align-items: center; gap: 12rpx; }
.ratio-label { width: 80rpx; font-size: 20rpx; color: #888; font-weight: 600; flex-shrink: 0; }
.ratio-bar-bg {
  flex: 1; height: 22rpx; background: #f0f0f0; border-radius: 999rpx; overflow: hidden;
}
.ratio-bar-fill { height: 100%; border-radius: 999rpx; transition: width 0.5s ease; }
.ratio-bar-fill.ratio-mine { background: linear-gradient(90deg, #ffb6c1, #ff6b8a); }
.ratio-bar-fill.ratio-partner { background: linear-gradient(90deg, #a5d8ff, #4dabf7); }
.ratio-pct { width: 50rpx; font-size: 20rpx; color: #999; font-weight: 700; text-align: right; flex-shrink: 0; }

.empty-hint {
  text-align: center; padding: 60rpx 0; font-size: 26rpx; color: #ccc;
}
.bottom-space { height: 40rpx; }

/* ==================== 预算 ==================== */
.budget-section {
  margin-top: 18rpx; padding: 16rpx 20rpx;
  background: rgba(255,255,255,0.45); border-radius: 18rpx;
  border: 1rpx solid rgba(255,182,193,0.15);
}
.budget-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.budget-title { font-size: 22rpx; font-weight: 600; color: #666; }
.budget-edit { font-size: 20rpx; color: #ffb6c1; padding: 4rpx 14rpx; background: rgba(255,182,193,0.06); border-radius: 999rpx; }
.budget-bar-bg {
  height: 14rpx; background: #f0f0f0; border-radius: 999rpx; overflow: hidden; margin-bottom: 8rpx;
}
.budget-bar-fill { height: 100%; border-radius: 999rpx; transition: width 0.5s ease, background 0.5s ease; }
.budget-info { display: flex; justify-content: space-between; }
.budget-used { font-size: 18rpx; color: #999; font-weight: 600; }
.budget-used.danger { color: #ff6b8a; }
.budget-left { font-size: 18rpx; color: #4ecdc4; font-weight: 600; }
.budget-pct { font-size: 18rpx; color: #999; font-weight: 700; }
.budget-pct.danger { color: #ff6b8a; }
.budget-empty {
  text-align: center; padding: 14rpx 0; font-size: 22rpx; color: #ffb6c1;
  font-weight: 600; border: 2rpx dashed rgba(255,182,193,0.25); border-radius: 14rpx;
}

/* ==================== 预算弹窗 ==================== */
.budget-dialog { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 300; display: flex; align-items: center; justify-content: center; }
.bd-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.35); }
.bd-card {
  position: relative; width: 560rpx; background: #fff; border-radius: 28rpx;
  padding: 36rpx 32rpx 28rpx; box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.12);
}
.bd-title { font-size: 30rpx; font-weight: 700; color: #333; text-align: center; margin-bottom: 24rpx; }
.bd-input {
  height: 84rpx; background: #fafafa; border-radius: 18rpx; padding: 0 22rpx;
  font-size: 30rpx; box-sizing: border-box; margin-bottom: 24rpx; color: #333; text-align: center;
}
.bd-btns { display: flex; gap: 14rpx; }
.bd-cancel {
  flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center;
  background: #f5f5f5; border-radius: 999rpx; font-size: 26rpx; color: #999; font-weight: 600;
}
.bd-confirm {
  flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #ff9eb5, #ff6b8a); color: #fff; border-radius: 999rpx;
  font-size: 26rpx; font-weight: 700; box-shadow: 0 4rpx 16rpx rgba(255,107,138,0.25);
}
